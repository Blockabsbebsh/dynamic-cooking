{
	"multipart": [
		{
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot"
			}
		},
		{
			"when": {
				"legs": "short"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_legs_short"
			}
		},
		{
			"when": {
				"legs": "long"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_legs_long"
			}
		},
		{
			"when": {
				"fill": "1",
				"liquid": "true"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_liquid_1"
			}
		},
		{
			"when": {
				"fill": "1",
				"liquid": "false"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_mash_1"
			}
		},
		{
			"when": {
				"fill": "2",
				"liquid": "true"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_liquid_2"
			}
		},
		{
			"when": {
				"fill": "2",
				"liquid": "false"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_mash_2"
			}
		},
		{
			"when": {
				"fill": "3",
				"liquid": "true"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_liquid_3"
			}
		},
		{
			"when": {
				"fill": "3",
				"liquid": "false"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_mash_3"
			}
		},
		{
			"when": {
				"fill": "4",
				"liquid": "true"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_liquid_4"
			}
		},
		{
			"when": {
				"fill": "4",
				"liquid": "false"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_mash_4"
			}
		},
		{
			"when": {
				"fill": "5",
				"liquid": "true"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_liquid_5"
			}
		},
		{
			"when": {
				"fill": "5",
				"liquid": "false"
			},
			"apply": {
				"model": "dynamic_cooking:block/cooking_pot_mash_5"
			}
		}
	]
}
